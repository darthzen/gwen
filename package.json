{
  "name": "gwen",
  "version": "0.8.1",
  "description": "Gwen, a concierge agent on the OpenRouter Agent SDK with pluggable chat adapters",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@openrouter/agent": "1.2.2",
    "@openrouter/sdk": "1.5.128",
    "croner": "^11.0.1",
    "nostr-tools": "^2.10.0",
    "ssh2": "1.17.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
